{
  "name": "cv-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for the cv editor (Cloudflare Worker, admin-only, Google OAuth). Single server \u2014 supersedes the stdio ../mcp-server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "lint": "eslint . && prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@cv/constants": "file:../shared",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260627.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "~8.62.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 100
  }
}
