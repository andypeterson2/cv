{
  "name": "cv-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Remote MCP server for the cv editor (Cloudflare Worker, admin-only, Google OAuth). Single server — supersedes the stdio ../mcp-server.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/workers-oauth-provider": "^0.8.1",
    "@cv/constants": "file:../shared",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "agents": "^0.17.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^5.20260713.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0"
  }
}
