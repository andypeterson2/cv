{
  "name": "cv-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Web editor for LaTeX resume/CV/cover letter",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:all": "jest && vitest run --config vitest.config.js",
    "test:unit": "jest --testPathPatterns='tests/unit'",
    "test:integration": "jest --testPathPatterns='tests/integration'",
    "test:dom": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "better-sqlite3": "^12.8.0",
    "cors": "^2.8.5",
    "express": "^4.21.0"
  },
  "jest": {
    "testPathIgnorePatterns": ["/node_modules/", "tests/dom/"]
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "happy-dom": "^20.8.9",
    "jest": "^29.7.0",
    "vitest": "^4.1.2"
  }
}
