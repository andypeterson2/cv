{
  "name": "cv-editor",
  "version": "1.0.0",
  "private": true,
  "description": "Web editor for LaTeX resume/CV/cover letter",
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node dev-watch.cjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:dom": "vitest run tests/dom",
    "lint": "eslint . && prettier --check '**/*.{js,cjs,mjs}'",
    "format": "prettier --write '**/*.{js,cjs,mjs}'"
  },
  "dependencies": {
    "@cv/constants": "file:../shared",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "extract-zip": "^2.0.1",
    "multer": "^2.3.0",
    "nunjucks": "^3.2.4"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^16.5.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "vitest": "^4.1.2"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "printWidth": 100
  }
}
