{
  "id": "awesome-cv",
  "name": "Awesome CV",
  "version": "1.0.0",
  "description": "The original Awesome-CV layout \u2014 single-column CV/resume with a colored accent, social header, and matching cover letter. The reference implementation of the layout contract.",
  "author": "builtin",
  "engine": "nunjucks",
  "contextVersion": 1,
  "kinds": [
    "cv",
    "resume",
    "coverletter"
  ],
  "entry": {
    "document": "templates/document.tex.njk",
    "coverletter": "templates/coverletter.tex.njk"
  },
  "main": "{kind}.tex",
  "classFiles": [
    "class/FontAwesome6Brands-Regular-400.otf",
    "class/FontAwesome6Free-Regular-400.otf",
    "class/FontAwesome6Free-Solid-900.otf",
    "class/accsupp.sty",
    "class/awesome-cv.cls",
    "class/fontawesome6-generic-helper.sty",
    "class/fontawesome6-utex-helper.sty",
    "class/fontawesome6.sty",
    "class/tufontawesome6brands.fd",
    "class/tufontawesome6free.fd"
  ]
}
