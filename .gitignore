.*
!.git*
!.dashboard.yaml
!.dockerignore
!.nvmrc

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.fls
*.fdb_latexmk
*.synctex.gz

# SQLite database (source of truth, not committed)
cv.db
cv.db-wal
cv.db-shm

# SQLite manual backups (contain real CV data — never commit).
# scripts/backup-db.sh writes timestamped snapshots into backups/.
cv.db.bak*
backups/

# Generated build output
build/

# Test coverage reports
coverage/

# Editor dependencies
editor/node_modules/

# MCP server dependencies
mcp-server/node_modules/

# uploaded layout bundles (dev store; deploy uses /data/layouts volume)
layouts-store/
